# ─────────────────────────────────────────────────────────
# Tiffin Platform — Environment Variables Template
# ─────────────────────────────────────────────────────────
# This file IS pushed to GitHub — it shows what variables
# are needed but contains NO real values.
#
# Setup instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never push .env to GitHub
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
DB_USERNAME=
DB_PASSWORD=

USER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_users
PROVIDER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_providers
MENU_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_menus
ORDER_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_orders
SUBSCRIPTION_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_subscriptions
PAYMENT_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_payments
ADMIN_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/tiffin_admin

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── Kafka ─────────────────────────────────────────────────
KAFKA_SERVERS=localhost:9092

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Payment Gateway (Razorpay) ────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email ─────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
